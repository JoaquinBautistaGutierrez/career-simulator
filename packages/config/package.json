{
  "name": "@career-simulator/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint": "./eslint/base.mjs",
    "./prettier": "./prettier/base.mjs",
    "./typescript/app.json": "./typescript/app.json",
    "./typescript/base.json": "./typescript/base.json",
    "./typescript/library.json": "./typescript/library.json",
    "./vitest": "./vitest/base.mjs"
  },
  "files": [
    "dist",
    "eslint",
    "prettier",
    "typescript",
    "vitest"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" --config ../../eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
